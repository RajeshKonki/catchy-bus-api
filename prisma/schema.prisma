generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  fullName  String?
  photoUrl  String?
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model College {
  id                String    @id @default(uuid())
  name              String
  address           String
  lat               Float
  lng               Float
  phone             String
  email             String
  loginEmail        String    @unique
  loginPassword     String
  availability      Boolean   @default(true)
  imageUrl          String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  contactPerson     String?
  subscriptionEnd   DateTime?
  subscriptionStart DateTime?
  subscriptionType  Int?
  buses             Bus[]
  drivers           Driver[]
  routes            Route[]
  students          Student[]
  banners           Banner[]
}

model Route {
  id           String   @id @default(uuid())
  name         String
  startPoint   String
  endPoint     String
  distance     Float?
  status       Status   @default(ACTIVE)
  collegeId    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  duration     Int?
  stops        Json?
  endAddress   String?
  endLat       Float?
  endLng       Float?
  startAddress String?
  startLat     Float?
  startLng     Float?
  endTime          String?
  startTime        String?
  reverseStartTime String?
  reverseEndTime   String?
  buses        Bus[]
  trips        Trip[]
  driverRoutes DriverRoute[]
  busRoutes    BusRoute[]
  college      College  @relation(fields: [collegeId], references: [id])
}

model BusRoute {
  busId   String
  routeId String
  bus     Bus    @relation(fields: [busId], references: [id])
  route   Route  @relation(fields: [routeId], references: [id])

  @@id([busId, routeId])
}

model Bus {
  id          String    @id @default(uuid())
  busNumber   String    @unique
  capacity    Int
  status      Status    @default(ACTIVE)
  collegeId   String
  routeId     String?
  imageUrl    String?
  latitude    Float?
  longitude   Float?
  bearing     Float?    @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  description String?
  title       String?
  college     College   @relation(fields: [collegeId], references: [id])
  route       Route?    @relation(fields: [routeId], references: [id])
  busRoutes   BusRoute[]
  driver      Driver?
  students    Student[]
  trips       Trip[]
}

model Trip {
  id          String    @id @default(uuid())
  busId       String
  routeId     String?
  status      String    @default("STARTED")
  startTime   DateTime  @default(now())
  endTime     DateTime?
  passedStops Json?
  isReverse   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bus         Bus       @relation(fields: [busId], references: [id])
  route       Route?    @relation(fields: [routeId], references: [id])
}

model DriverRoute {
  id        String   @id @default(uuid())
  driverId  String
  routeId   String
  createdAt DateTime @default(now())
  driver    Driver   @relation(fields: [driverId], references: [id])
  route     Route    @relation(fields: [routeId], references: [id])

  @@unique([driverId, routeId])
}

model Driver {
  id            String   @id @default(uuid())
  name          String
  licenseNumber String
  phone         String
  status        Status   @default(ACTIVE)
  photoUrl      String?
  collegeId     String
  busId         String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  email         String   @unique
  password      String
  fcmToken      String?
  bus           Bus?     @relation(fields: [busId], references: [id])
  college       College  @relation(fields: [collegeId], references: [id])
  driverRoutes  DriverRoute[]
}

model Student {
  id                   String         @id @default(uuid())
  phone                String
  profilePictureUrl    String?
  collegeId            String
  busId                String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  email                String?        @unique
  name                 String
  status               Status         @default(ACTIVE)
  password             String?
  pickupStop           String?
  fcmToken             String?
  notificationSettings Json?
  studentId            String?
  department           String?
  year                 String?
  attendances          Attendance[]
  notifications        Notification[]
  bus                  Bus?           @relation(fields: [busId], references: [id])
  college              College        @relation(fields: [collegeId], references: [id])
}

model Notification {
  id          String   @id @default(uuid())
  title       String
  body        String
  data        Json?
  studentId   String
  phoneNumber String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  student     Student  @relation(fields: [studentId], references: [id])
}

model Attendance {
  id        String   @id @default(uuid())
  studentId String
  status    String   @default("PRESENT")
  stopName  String?
  busId     String
  timestamp DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id])
}

model Activity {
  id          String   @id @default(uuid())
  type        String
  description String
  userId      String?
  timestamp   DateTime @default(now())
}

model Banner {
  id        String   @id @default(uuid())
  title     String?
  imageUrl  String
  link      String?
  status    Status   @default(ACTIVE)
  order     Int      @default(0)
  collegeId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  college   College? @relation(fields: [collegeId], references: [id])
}

enum Status {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

model HelpdeskQuery {
  id          String   @id @default(uuid())
  subject     String
  message     String
  status      String   @default("OPEN")
  priority    String   @default("MEDIUM")
  senderId    String
  senderType  String
  senderName  String
  targetId    String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
